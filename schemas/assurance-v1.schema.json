{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "security-agent-skills/attack-path-v1"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "minItems": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "minItems": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "minItems": 1
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "state": {
                "enum": [
                  "open",
                  "blocked",
                  "unknown"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "from",
              "to",
              "state",
              "evidence"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 200
        }
      },
      "required": [
        "schema",
        "nodes",
        "entries",
        "assets",
        "edges"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "security-agent-skills/detection-replay-v1"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "equals": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 256
                }
              }
            },
            "required": [
              "id",
              "equals"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 32
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "fields": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 16,
                "propertyNames": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 100,
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "fields",
              "expected"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "schema",
        "rules",
        "events"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "security-agent-skills/regression-board-v1"
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "expected": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "baseline": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "candidate": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                },
                "maxItems": 100,
                "uniqueItems": true
              },
              "baseline_status": {
                "enum": [
                  "complete",
                  "partial",
                  "blocked"
                ]
              },
              "candidate_status": {
                "enum": [
                  "complete",
                  "partial",
                  "blocked"
                ]
              }
            },
            "required": [
              "id",
              "expected",
              "baseline",
              "candidate",
              "baseline_status",
              "candidate_status"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "schema",
        "cases"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "schema": {
          "const": "security-agent-skills/skill-route-v1"
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "maxItems": 100,
          "uniqueItems": true,
          "minItems": 1
        },
        "max_skills": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      },
      "required": [
        "schema",
        "goals",
        "max_skills"
      ],
      "additionalProperties": false
    }
  ]
}
